<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light counterpart of the DarkTheme palette. Colors only: brushes, shapes,
         styles and templates stay in DarkTheme.xaml and are repainted at runtime
         by AppearanceController, which copies these values onto the live brushes.
         The key set must mirror DarkTheme.xaml exactly, and every value stays
         fully opaque (#FF) because translucency is applied per role at runtime. -->
    <Color x:Key="CanvasColor">#FFF3F5F9</Color>
    <Color x:Key="SidebarColor">#FFE8EBF2</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#FFF7F8FC</Color>
    <Color x:Key="SurfaceHoverColor">#FFE4E8F1</Color>
    <Color x:Key="SurfaceSunkenColor">#FFEBEEF5</Color>
    <Color x:Key="BorderColor">#FFD3D8E4</Color>
    <Color x:Key="BorderStrongColor">#FFAEB6C6</Color>
    <Color x:Key="TextColor">#FF141824</Color>
    <Color x:Key="SecondaryTextColor">#FF4A5468</Color>
    <Color x:Key="MutedTextColor">#FF6B7382</Color>
    <Color x:Key="AccentColor">#FF5A46D6</Color>
    <Color x:Key="AccentStrongColor">#FF4634BE</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="AccentTintColor">#FFE8E5FB</Color>
    <Color x:Key="SuccessColor">#FF14804A</Color>
    <Color x:Key="SuccessForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="WarningColor">#FF9C5A05</Color>
    <Color x:Key="WarningForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="ErrorColor">#FFC22943</Color>
    <Color x:Key="ErrorSurfaceColor">#FFFCEBEE</Color>
    <Color x:Key="ErrorBorderColor">#FFEFADBA</Color>
    <Color x:Key="ErrorHoverColor">#FFF9D7DD</Color>
    <Color x:Key="ErrorPressedColor">#FFF4C2CB</Color>
    <Color x:Key="InfoColor">#FF1B6CCC</Color>
</ResourceDictionary>
