<Window x:Class="ZZZModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZZZ Mod Manager" Icon="Assets/AppIcon.ico"
        Width="1280" Height="820" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <Grid Background="{DynamicResource CanvasBrush}">
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed"
               IsHitTestVisible="False" CacheMode="BitmapCache" RenderOptions.BitmapScalingMode="LowQuality" />
        <!-- 遮罩由背景图透明度反向驱动：图越亮遮罩越薄，透明度调到最大时背景图完全可见。 -->
        <Rectangle x:Name="BackgroundVeil" Fill="{DynamicResource CanvasBrush}" Opacity="0.55"
                   IsHitTestVisible="False" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="182" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12,16,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="10,0,8,20">
                        <TextBlock Text="ZZZ" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="MOD MANAGER" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="绝区零 · 本地管理" Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="HomeNavButton" Style="{StaticResource NavButton}" GroupName="Navigation"
                                     IsChecked="True" Content="⌂   首页" Tag="Home" Checked="Navigation_Click" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Navigation"
                                     Content="⚙   设置" Tag="Settings" Checked="Navigation_Click" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Navigation"
                                     Content="≡   日志" Tag="Logs" Checked="Navigation_Click" />
                    </StackPanel>
                    <Border Grid.Row="3" Margin="0,8,0,0" Padding="11,10"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Alt + W" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="游戏内显示 / 隐藏" Margin="0,3,0,0" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="16,14,16,8">
                <Grid x:Name="HomePage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelBorder}" Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HeroTitle" Text="准备启动绝区零" FontSize="24" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse x:Name="GameStatusDot" Width="8" Height="8" Fill="{DynamicResource MutedTextBrush}"
                                             Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GameStatusText" Text="游戏未运行" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="RuntimeStatusText" Text="正在校验运行核心…"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ManualReloadButton" Content="安全刷新 Mod" Click="ManualReload_Click" />
                                <Button x:Name="PrimaryActionButton" Style="{StaticResource PrimaryButton}" MinWidth="168"
                                        MinHeight="40" FontSize="14" Content="启动绝区零" Click="PrimaryAction_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,8,0,8" Padding="11,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="CharacterFilterClip" ClipToBounds="True" MaxHeight="82"
                                    GotKeyboardFocus="CharacterFilterClip_GotKeyboardFocus">
                                <StackPanel>
                                    <ItemsControl x:Name="CharacterFiltersItemsControl"
                                                  SizeChanged="CharacterFilters_SizeChanged">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding Key}" Click="CharacterFilter_Click"
                                                        Background="{Binding Background}" BorderBrush="{Binding BorderBrush}"
                                                        Foreground="{Binding Foreground}" FontWeight="{Binding LabelWeight}"
                                                        Padding="10,6" MinHeight="34">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                        <Border Margin="7,0,0,0" Padding="5,1"
                                                                CornerRadius="{StaticResource PillRadius}"
                                                                Background="{DynamicResource SurfaceSunkenBrush}">
                                                            <TextBlock Text="{Binding CountText}" FontSize="10"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Button Grid.Row="1" x:Name="CharacterFilterExpandButton" Visibility="Collapsed"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Margin="3,5,0,0" Content="展开全部角色 ▾"
                                    Click="ToggleCharacterFilterExpand_Click" />
                            <Grid Grid.Row="2" Margin="3,8,3,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="164" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="搜索" Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="Mod / 角色 / 依赖" Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0" />
                                    <TextBox x:Name="SearchBox" Width="250" ToolTip="搜索 Mod 名称、角色或依赖"
                                             TextChanged="SearchBox_TextChanged" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="FilterResultText" VerticalAlignment="Center"
                                           Margin="10,0,4,0" Foreground="{DynamicResource MutedTextBrush}" />
                                <ComboBox x:Name="StatusFilterCombo" Grid.Column="2"
                                          SelectionChanged="StatusFilter_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Tag="All" Content="全部状态" />
                                    <ComboBoxItem Tag="Enabled" Content="已启用" />
                                    <ComboBoxItem Tag="Disabled" Content="已禁用" />
                                    <ComboBoxItem Tag="Dependency" Content="缺少依赖" />
                                    <ComboBoxItem Tag="Pending" Content="待应用 / 需刷新" />
                                </ComboBox>
                                <Button Grid.Column="3" Content="刷新" Click="Refresh_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ItemsControl x:Name="ModGroupsItemsControl"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      VirtualizingPanel.CacheLength="1,1"
                                      VirtualizingPanel.CacheLengthUnit="Page">
                            <!-- 虚拟化要求承载 IScrollInfo 的 ScrollViewer 位于 ItemsControl 模板内部，
                                 放在外面会让面板拿到无限高度，从而一次性实例化全部分组。 -->
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer x:Name="ModGridScrollViewer" Focusable="False"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  PanningMode="VerticalOnly" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2,0,12">
                                        <DockPanel Margin="6,0,8,5" LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Mods}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CardBorder}" Width="298" Height="360"
                                                            BorderBrush="{Binding StatusBrush}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="126" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <Button Padding="0" Margin="0" BorderThickness="0"
                                                                        BorderBrush="Transparent" Background="{DynamicResource SurfaceBrush}"
                                                                        Tag="{Binding}" Click="Preview_Click">
                                                                    <Grid ClipToBounds="True">
                                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                               RenderOptions.BitmapScalingMode="LowQuality" />
                                                                        <StackPanel Visibility="{Binding PreviewPlaceholderVisibility}"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <TextBlock Text="◌" FontSize="32" HorizontalAlignment="Center"
                                                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                                                            <TextBlock Text="无预览图" Margin="0,4,0,0"
                                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                        </StackPanel>
                                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,4"
                                                                                CornerRadius="{StaticResource PillRadius}" Background="{Binding StatusBrush}">
                                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                                       FontWeight="SemiBold" Foreground="{Binding StatusForeground}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Button>
                                                                <Grid Grid.Row="1" Margin="12,10,12,9">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Row="1" Text="{Binding CharacterDisplayName}" Margin="0,3,0,0"
                                                                               Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Grid.Row="2" Margin="0,7,0,0">
                                                                        <TextBlock Text="{Binding CapabilityText}" FontSize="11"
                                                                                   Foreground="{Binding CapabilityBrush}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding DependencyText}" Margin="0,3,0,0" FontSize="11"
                                                                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding RuntimeMessage}" Margin="0,3,0,0" FontSize="11"
                                                                                   Foreground="{DynamicResource InfoBrush}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <Button Grid.Row="3" x:Name="CardToggleButton"
                                                                            Tag="{Binding}" Click="ToggleMod_Click"
                                                                            Style="{StaticResource PrimaryButton}" MinHeight="36"
                                                                            Margin="0,7,0,0"
                                                                            ToolTip="方向键在卡片间移动，Enter 启用或禁用"
                                                                            Content="{Binding ToggleText}" HorizontalContentAlignment="Center" />
                                                                    <Button Grid.Row="4" x:Name="CardOverflowButton"
                                                                            Style="{StaticResource GhostButton}" Margin="0,6,0,0"
                                                                            Content="更多操作 ⋯" Tag="{Binding}"
                                                                            ToolTip="快捷键 / 诊断 / 目录 / 分组 / 删除"
                                                                            Click="CardOverflow_Click">
                                                                        <Button.ContextMenu>
                                                                            <ContextMenu Placement="Bottom">
                                                                                <MenuItem Header="游戏内快捷键" Tag="{Binding}" Click="ShowHotkeys_Click" />
                                                                                <MenuItem Header="导入诊断报告" Tag="{Binding}" Click="InspectMod_Click" />
                                                                                <MenuItem Header="打开安装目录" Tag="{Binding}" Click="OpenModDirectory_Click" />
                                                                                <MenuItem Header="更改角色分组" Tag="{Binding}" Click="ChangeGroup_Click" />
                                                                                <Separator />
                                                                                <MenuItem Style="{StaticResource DangerMenuItem}" Header="删除安装副本"
                                                                                          Tag="{Binding}" Click="DeleteMod_Click" />
                                                                            </ContextMenu>
                                                                        </Button.ContextMenu>
                                                                    </Button>
                                                                </Grid>
                                                            </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="EmptyStateBorder" Visibility="Collapsed" Width="390"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Style="{StaticResource PanelBorder}" Padding="22,18">
                            <StackPanel>
                                <TextBlock Text="没有匹配的 Mod" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyStateText" Text="尝试清除搜索、角色或状态筛选。"
                                           Margin="0,6,0,10" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Content="清除筛选" Click="ClearFilters_Click" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <StackPanel Margin="3,0,0,12">
                            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="运行核心、导入、外观与切换行为" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="游戏与运行核心" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="告诉管理器游戏位置，并确认 XXMI / ZZMI 运行核心可用。"
                                           Margin="3,4,0,8" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="ZenlessZoneZero.exe" Margin="3,0,0,2"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GamePathBox" LostFocus="GamePathBox_LostFocus" />
                                    <Button Grid.Column="1" Content="选择游戏" Click="BrowseGame_Click" />
                                </Grid>
                                <TextBlock x:Name="SettingsRuntimeStatusText" Margin="3,6,0,4" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="导入已授权运行核心" Click="ImportRuntime_Click" />
                                    <Button Content="离线修复运行核心" Click="RepairRuntime_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Mod 库位置" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Mod、配置、日志与备份都保存在这个目录下。换盘或空间不足时可以整体迁移。"
                                           Margin="3,4,0,8" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="库根目录" Margin="3,0,0,2"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ModRootBox" IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="更换目录" Click="BrowseModRoot_Click" />
                                </Grid>
                                <TextBlock x:Name="ModRootHintText" Margin="3,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ImportDropZone" Style="{StaticResource PanelBorder}" Margin="0,0,0,8" MinHeight="88"
                                AllowDrop="True" Drop="ImportDropZone_Drop" DragOver="ImportDropZone_DragOver">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="把 GameBanana 的 ZIP / 7Z / RAR 或文件夹拖到这里"
                                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="自动识别 Mod 根目录，扫描后安装副本。"
                                               Margin="0,4,0,7" Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center" />
                                    <WrapPanel HorizontalAlignment="Center">
                                        <Button Content="导入压缩包" Click="ImportMods_Click" />
                                        <Button Content="导入文件夹" Click="ImportFolder_Click" />
                                        <Button Content="打开 Mod 库" Click="OpenMods_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="主题决定配色，透明度只影响装饰层，不会削弱状态与文字识别。"
                                           Margin="3,4,0,7" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="界面主题" Margin="3,0,0,4"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <ComboBox x:Name="ThemeComboBox" Width="245" HorizontalAlignment="Left"
                                          SelectedValuePath="Tag" SelectionChanged="Theme_Changed">
                                    <ComboBoxItem Tag="Dark" Content="暗色" />
                                    <ComboBoxItem Tag="Light" Content="亮色" />
                                </ComboBox>
                                <TextBlock Text="菜单栏透明度" Margin="3,10,0,4"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider x:Name="SidebarOpacitySlider" Width="245" HorizontalAlignment="Left"
                                        Minimum="0.45" Maximum="1" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="ChromeOpacity_Changed" />
                                <TextBlock Text="界面面板透明度" Margin="3,10,0,4"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider x:Name="PanelOpacitySlider" Width="245" HorizontalAlignment="Left"
                                        Minimum="0.45" Maximum="1" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="ChromeOpacity_Changed" />
                                <TextBlock Text="背景图强度" Margin="3,10,0,4"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider x:Name="BackgroundOpacitySlider" Width="245" HorizontalAlignment="Left"
                                        Minimum="0" Maximum="1" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="BackgroundOpacity_Changed" />
                                <TextBlock x:Name="BackgroundPathText" Margin="3,10,0,5"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="设置背景图" Click="SetBackground_Click" />
                                    <Button Content="清除背景图" Click="ClearBackground_Click" />
                                    <Button Content="恢复默认外观" Style="{StaticResource UtilityButton}"
                                            Click="ResetAppearance_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="切换行为" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="管理器会把可安全控制的变化发送给运行中的游戏；渲染结果需在游戏内确认。"
                                           Margin="3,4,0,4" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <CheckBox x:Name="AutoHideCheckBox"
                                          Content="实时切换命令发送且状态保存后隐藏管理器并切回游戏"
                                          Click="BehaviorOption_Changed" />
                                <CheckBox x:Name="ReloadRequiredCheckBox"
                                          Content="首次同步、导入或目录变化时自动执行一次安全重载"
                                          Click="BehaviorOption_Changed" />
                                <TextBlock Text="窗口关闭按钮" Margin="3,8,0,4" Foreground="{DynamicResource MutedTextBrush}" />
                                <WrapPanel>
                                    <ComboBox x:Name="CloseBehaviorComboBox" Width="245"
                                              SelectedValuePath="Tag" SelectionChanged="CloseBehavior_Changed">
                                        <ComboBoxItem Tag="Exit" Content="直接退出管理器" />
                                        <ComboBoxItem Tag="HideToBackground" Content="隐藏到后台（Alt+W 恢复）" />
                                    </ComboBox>
                                    <Button Content="退出管理器" Click="ExitManager_Click" />
                                </WrapPanel>
                                <StackPanel x:Name="SwitchBehaviorNotes" MaxWidth="620"
                                            HorizontalAlignment="Left" Margin="4,10,0,0">
                                    <TextBlock Text="立即生效" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="· 普通切换发送绝对状态命令；同角色或同 hash 切换会自动安全刷新。"
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="· 启动游戏前已预载全部静态 Mod，同 hash 由 XXMI 按最大字节容量处理。"
                                               Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="需要重启游戏" Margin="0,11,0,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WarningBrush}" />
                                    <TextBlock Text="· 游戏运行之后才新增、因此尚未被预载的静态 Mod。"
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="· 规则升级尚未完成启动前准备，需由管理器重新启动一次。"
                                               Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="F10 只用于隐藏 ZZMI 首次帮助提示，安全重载走独立内部通道；管理器读不到游戏渲染结果，最终画面请在游戏内确认。"
                                               Margin="0,11,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="3,0,0,10">
                        <TextBlock Text="日志" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="LogRetentionText" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="7" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="搜索" Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="3,0,5,0" />
                                <TextBox x:Name="LogSearchBox" Width="260" ToolTip="搜索日志内容或级别"
                                         TextChanged="LogSearchBox_TextChanged" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource UtilityButton}" Content="复制" Click="CopyLogs_Click" />
                            <Button Grid.Column="2" Style="{StaticResource UtilityButton}" Content="刷新" Click="RefreshLogs_Click" />
                            <Button Grid.Column="3" Style="{StaticResource UtilityButton}" Content="清理日志" Click="CleanupLogs_Click" />
                            <Button Grid.Column="4" Style="{StaticResource UtilityButton}" Content="打开日志目录" Click="OpenLogs_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="7">
                        <ListBox x:Name="LogListBox" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" ToolTip="{Binding FullTimeText}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" Foreground="{Binding LevelBrush}"
                                                   FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <DockPanel Grid.Column="1" Grid.Row="1" Margin="17,0,17,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                <TextBlock x:Name="BusyText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" FontSize="11" />
            </DockPanel>
            <Border x:Name="ToastBorder" Grid.Column="1" Grid.Row="0" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,18,0,0" Padding="15,10" CornerRadius="{StaticResource ControlRadius}"
                    Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <TextBlock x:Name="ToastText" MaxWidth="720" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <Border x:Name="LightboxOverlay" Visibility="Collapsed" Background="#E9000000"
                MouseLeftButtonDown="LightboxBackdrop_Click">
            <Grid Margin="24">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="LightboxImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Value, ElementName=LightboxZoomSlider}"
                                            ScaleY="{Binding Value, ElementName=LightboxZoomSlider}" />
                        </Image.RenderTransform>
                    </Image>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="缩放" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="LightboxZoomSlider" Width="140" Minimum="0.5" Maximum="3"
                            Value="1" TickFrequency="0.25" />
                    <Button Content="关闭 (Esc)" Click="CloseLightbox_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
