<Window x:Class="ZZZModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZZZ Mod Manager" Icon="Assets/AppIcon.ico"
        Width="1280" Height="820" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <Grid Background="{StaticResource CanvasBrush}">
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.18" Visibility="Collapsed"
               IsHitTestVisible="False" CacheMode="BitmapCache" RenderOptions.BitmapScalingMode="LowQuality" />
        <Rectangle Fill="{StaticResource CanvasBrush}" Opacity="0.78" IsHitTestVisible="False" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="182" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12,16,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="10,0,8,20">
                        <TextBlock Text="ZZZ" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="MOD MANAGER" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="绝区零 · 本地管理" Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="HomeNavButton" Style="{StaticResource NavButton}" GroupName="Navigation"
                                     IsChecked="True" Content="⌂   首页" Tag="Home" Checked="Navigation_Click" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Navigation"
                                     Content="⚙   设置" Tag="Settings" Checked="Navigation_Click" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Navigation"
                                     Content="≡   日志" Tag="Logs" Checked="Navigation_Click" />
                    </StackPanel>
                    <Border Grid.Row="3" Margin="0,8,0,0" Padding="11,10" CornerRadius="8"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Alt + W" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="游戏内显示 / 隐藏" Margin="0,3,0,0" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="16,14,16,8">
                <Grid x:Name="HomePage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelBorder}" Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HeroTitle" Text="准备启动绝区零" FontSize="24" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse x:Name="GameStatusDot" Width="8" Height="8" Fill="{StaticResource MutedTextBrush}"
                                             Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GameStatusText" Text="游戏未运行" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="  ·  " Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="RuntimeStatusText" Text="正在校验运行核心…"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ManualReloadButton" Content="安全刷新 Mod" Click="ManualReload_Click" />
                                <Button x:Name="PrimaryActionButton" Style="{StaticResource PrimaryButton}" MinWidth="168"
                                        MinHeight="40" FontSize="14" Content="启动绝区零" Click="PrimaryAction_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,8,0,8" Padding="11,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ItemsControl x:Name="CharacterFiltersItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Key}" Click="CharacterFilter_Click"
                                                Background="{Binding Background}" BorderBrush="{Binding BorderBrush}"
                                                Padding="10,6" MinHeight="32">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" />
                                                <Border Margin="7,0,0,0" Padding="5,1" CornerRadius="6"
                                                        Background="#FF0F1720">
                                                    <TextBlock Text="{Binding CountText}" FontSize="10"
                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Grid.Row="1" Margin="3,8,3,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="164" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="搜索" Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="Mod / 角色 / 依赖" Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0" />
                                    <TextBox x:Name="SearchBox" Width="250" ToolTip="搜索 Mod 名称、角色或依赖"
                                             TextChanged="SearchBox_TextChanged" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="FilterResultText" VerticalAlignment="Center"
                                           Margin="10,0,4,0" Foreground="{StaticResource MutedTextBrush}" />
                                <ComboBox x:Name="StatusFilterCombo" Grid.Column="2"
                                          SelectionChanged="StatusFilter_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Tag="All" Content="全部状态" />
                                    <ComboBoxItem Tag="Enabled" Content="已启用" />
                                    <ComboBoxItem Tag="Disabled" Content="已禁用" />
                                    <ComboBoxItem Tag="Dependency" Content="缺少依赖" />
                                    <ComboBoxItem Tag="Pending" Content="待应用 / 需刷新" />
                                </ComboBox>
                                <Button Grid.Column="3" Content="刷新" Click="Refresh_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly" CanContentScroll="False">
                            <ItemsControl x:Name="ModGroupsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2,0,12">
                                            <DockPanel Margin="6,0,8,5" LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Mods}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource CardBorder}" Width="298" Height="360"
                                                                BorderBrush="{Binding StatusBrush}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="126" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <Button Padding="0" Margin="0" BorderThickness="0"
                                                                        BorderBrush="Transparent" Background="{StaticResource SurfaceBrush}"
                                                                        Tag="{Binding}" Click="Preview_Click">
                                                                    <Grid ClipToBounds="True">
                                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                               RenderOptions.BitmapScalingMode="LowQuality" />
                                                                        <StackPanel Visibility="{Binding PreviewPlaceholderVisibility}"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <TextBlock Text="◌" FontSize="32" HorizontalAlignment="Center"
                                                                                       Foreground="{StaticResource MutedTextBrush}" />
                                                                            <TextBlock Text="无 preview.png" Margin="0,4,0,0"
                                                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                                                        </StackPanel>
                                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,4"
                                                                                CornerRadius="8" Background="{Binding StatusBrush}">
                                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                                       FontWeight="SemiBold" Foreground="{Binding StatusForeground}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Button>
                                                                <Grid Grid.Row="1" Margin="12,10,12,9">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Row="1" Text="{Binding CharacterDisplayName}" Margin="0,3,0,0"
                                                                               Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Grid.Row="2" Margin="0,7,0,0">
                                                                        <TextBlock Text="{Binding CapabilityText}" FontSize="11"
                                                                                   Foreground="{Binding CapabilityBrush}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding DependencyText}" Margin="0,3,0,0" FontSize="11"
                                                                                   Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding RuntimeMessage}" Margin="0,3,0,0" FontSize="11"
                                                                                   Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <Button Grid.Row="3" Tag="{Binding}" Click="ToggleMod_Click"
                                                                            Style="{StaticResource PrimaryButton}" MinHeight="35"
                                                                            Content="{Binding ToggleText}" HorizontalContentAlignment="Center" />
                                                                    <UniformGrid Grid.Row="4" Columns="5" Margin="-2,2,-2,-2">
                                                                        <Button Style="{StaticResource UtilityButton}" Content="快捷键" Tag="{Binding}" Click="ShowHotkeys_Click" />
                                                                        <Button Style="{StaticResource UtilityButton}" Content="诊断" Tag="{Binding}" Click="InspectMod_Click" />
                                                                        <Button Style="{StaticResource UtilityButton}" Content="目录" Tag="{Binding}" Click="OpenModDirectory_Click" />
                                                                        <Button Style="{StaticResource UtilityButton}" Content="分组" Tag="{Binding}" Click="ChangeGroup_Click" />
                                                                        <Button Style="{StaticResource DangerButton}" Content="删除" Tag="{Binding}" Click="DeleteMod_Click" />
                                                                    </UniformGrid>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border x:Name="EmptyStateBorder" Visibility="Collapsed" Width="390"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Style="{StaticResource PanelBorder}" Padding="22,18">
                            <StackPanel>
                                <TextBlock Text="没有匹配的 Mod" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyStateText" Text="尝试清除搜索、角色或状态筛选。"
                                           Margin="0,6,0,10" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Content="清除筛选" Click="ClearFilters_Click" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel>
                        <StackPanel Margin="3,0,0,12">
                            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="运行核心、导入、外观与切换行为" Margin="0,4,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="游戏与运行核心" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="告诉管理器游戏位置，并确认 XXMI / ZZMI 运行核心可用。"
                                           Margin="3,4,0,8" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="ZenlessZoneZero.exe" Margin="3,0,0,2"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GamePathBox" LostFocus="GamePathBox_LostFocus" />
                                    <Button Grid.Column="1" Content="选择游戏" Click="BrowseGame_Click" />
                                </Grid>
                                <TextBlock x:Name="SettingsRuntimeStatusText" Margin="3,6,0,4" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="导入已授权运行核心" Click="ImportRuntime_Click" />
                                    <Button Content="离线修复运行核心" Click="RepairRuntime_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ImportDropZone" Style="{StaticResource PanelBorder}" Margin="0,0,0,8" MinHeight="112"
                                AllowDrop="True" Drop="ImportDropZone_Drop" DragOver="ImportDropZone_DragOver">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="把 GameBanana 的 ZIP / 7Z / RAR 或文件夹拖到这里"
                                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="自动识别 Mod 根目录，扫描后安装副本。"
                                               Margin="0,4,0,7" Foreground="{StaticResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center" />
                                    <WrapPanel HorizontalAlignment="Center">
                                        <Button Content="导入压缩包" Click="ImportMods_Click" />
                                        <Button Content="导入文件夹" Click="ImportFolder_Click" />
                                        <Button Content="打开 Mod 库" Click="OpenMods_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="背景图只作弱化氛围，不影响状态与文字识别。"
                                           Margin="3,4,0,7" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="BackgroundPathText" Margin="3,0,0,5"
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="设置背景图" Click="SetBackground_Click" />
                                    <Button Content="清除背景图" Click="ClearBackground_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="切换行为" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="管理器会把可安全控制的变化发送给运行中的游戏；渲染结果需在游戏内确认。"
                                           Margin="3,4,0,4" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <CheckBox x:Name="AutoHideCheckBox"
                                          Content="实时切换命令发送且状态保存后隐藏管理器并切回游戏"
                                          Click="BehaviorOption_Changed" />
                                <CheckBox x:Name="ReloadRequiredCheckBox"
                                          Content="首次同步、导入或目录变化时自动执行一次安全重载"
                                          Click="BehaviorOption_Changed" />
                                <TextBlock Text="窗口关闭按钮" Margin="3,8,0,4" Foreground="{StaticResource MutedTextBrush}" />
                                <WrapPanel>
                                    <ComboBox x:Name="CloseBehaviorComboBox" Width="245"
                                              SelectedValuePath="Tag" SelectionChanged="CloseBehavior_Changed">
                                        <ComboBoxItem Tag="Exit" Content="直接退出管理器" />
                                        <ComboBoxItem Tag="HideToBackground" Content="隐藏到后台（Alt+W 恢复）" />
                                    </ComboBox>
                                    <Button Content="退出管理器" Click="ExitManager_Click" />
                                </WrapPanel>
                                <TextBlock Text="普通 F10 只用于隐藏 ZZMI 首次帮助提示；管理器安全重载使用独立内部通道。管理器启动游戏前会预载所有静态 Mod，同 hash 由 XXMI 取最大字节容量处理。普通切换发送绝对状态命令；同角色或同 hash 切换可能自动安全刷新但无需重启。只有游戏运行后才新增尚未预载的静态 Mod，或规则升级尚未完成启动前准备时，才需关闭并由管理器重新启动一次。管理器无法读取游戏渲染结果，请在游戏内确认画面。"
                                           TextWrapping="Wrap" Margin="4,8,0,0"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="3,0,0,10">
                        <TextBlock Text="日志" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="LogRetentionText" Margin="0,4,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="7" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="搜索" Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="3,0,5,0" />
                                <TextBox x:Name="LogSearchBox" Width="260" ToolTip="搜索日志内容或级别"
                                         TextChanged="LogSearchBox_TextChanged" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource UtilityButton}" Content="复制" Click="CopyLogs_Click" />
                            <Button Grid.Column="2" Style="{StaticResource UtilityButton}" Content="刷新" Click="RefreshLogs_Click" />
                            <Button Grid.Column="3" Style="{StaticResource UtilityButton}" Content="清理日志" Click="CleanupLogs_Click" />
                            <Button Grid.Column="4" Style="{StaticResource UtilityButton}" Content="打开日志目录" Click="OpenLogs_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="7">
                        <ListBox x:Name="LogListBox" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" Foreground="{Binding LevelBrush}"
                                                   FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <DockPanel Grid.Column="1" Grid.Row="1" Margin="17,0,17,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                <TextBlock x:Name="BusyText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" FontSize="11" />
            </DockPanel>
        </Grid>

        <Border x:Name="ToastBorder" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="198,18,18,0" Padding="15,10" CornerRadius="9"
                Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
            <TextBlock x:Name="ToastText" MaxWidth="720" TextWrapping="Wrap" />
        </Border>

        <Border x:Name="LightboxOverlay" Visibility="Collapsed" Background="#E9000000"
                MouseLeftButtonDown="LightboxBackdrop_Click">
            <Grid Margin="24">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="LightboxImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Value, ElementName=LightboxZoomSlider}"
                                            ScaleY="{Binding Value, ElementName=LightboxZoomSlider}" />
                        </Image.RenderTransform>
                    </Image>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="缩放" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="LightboxZoomSlider" Width="140" Minimum="0.5" Maximum="3"
                            Value="1" TickFrequency="0.25" />
                    <Button Content="关闭 (Esc)" Click="CloseLightbox_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
